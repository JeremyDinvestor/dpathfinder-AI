# Copy this file to ".env" (same folder) and replace every "replace_me" value.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string (include the database name, e.g. /dpathfinder)
MONGODB_URI=replace_me_mongodb_connection_string

# Google Gemini
GEMINI_API_KEY=replace_me_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Two DIFFERENT random secrets, at least 32 characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_random_secret_one
API_KEY_SECRET=replace_me_random_secret_two

# Frontend addresses allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ---- Optional settings (defaults shown) ----
# JWT_EXPIRES_IN=1d
# BCRYPT_ROUNDS=12
# GEMINI_TIMEOUT_MS=30000
# DEMO_RESET_COOLDOWN_SECONDS=30
# AUTH_RATE_LIMIT=10          # login/register requests per 15 min per IP
# DEMO_CHAT_RATE_LIMIT=10     # demo chat requests per 15 min per IP
# DEMO_RESET_RATE_LIMIT=3     # demo resets per hour per IP
# API_RATE_LIMIT=300          # all /api/v1 requests per 15 min per IP
